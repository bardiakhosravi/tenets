{
  "name": "tenets",
  "version": "0.13.0",
  "description": "Architecture guardrails for AI coding agents building backend services with DDD and Hexagonal Architecture",
  "bin": {
    "tenets": "bin/tenets.js"
  },
  "scripts": {
    "catalog": "node scripts/build-knowledge.js",
    "validate": "node scripts/build-knowledge.js --check",
    "bundle": "npm run catalog && node scripts/bundle-content.js",
    "test": "npm run validate && node --test",
    "prepublishOnly": "npm run bundle"
  },
  "keywords": [
    "ddd",
    "hexagonal-architecture",
    "coding-standards",
    "ai-agents",
    "code-review-agent",
    "claude",
    "cursor",
    "augment",
    "copilot",
    "spec-kit",
    "spec-driven-development"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bardiakhosravi/tenets.git",
    "directory": "cli"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    "src/",
    "bundled/",
    "templates/"
  ]
}
